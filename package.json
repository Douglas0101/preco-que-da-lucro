{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/build.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:ui": "eslint src/components/ui src/components/app-shell.tsx src/routes src/test --rule '@typescript-eslint/no-explicit-any: off'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:ui:check": "prettier --check components.json package.json eslint.config.js playwright.config.ts vitest.config.ts scripts src/components/ui src/components/app-shell.tsx 'src/routes/**/*.{ts,tsx}' src/test e2e .github/workflows .migration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:test": "tsx scripts/db/test-migrations.ts && tsx scripts/db/test-auth-integration.ts && tsx scripts/db/test-tool-security.ts",
    "migration:supabase-to-neon": "tsx scripts/migration/source-to-neon.ts",
    "e2e:prepare": "tsx scripts/e2e/seed-auth.ts",
    "test:e2e": "playwright test",
    "check:ui-stack": "node scripts/check-ui-stack.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run check:ui-stack && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth/drizzle-adapter": "^1.6.27",
    "@hookform/resolvers": "^5.2.2",
    "@lovable.dev/cloud-auth-js": "^1.1.2",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.168.18",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "10.6.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "pg": "^8.23.0",
    "resend": "^6.19.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "^2.8.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.12.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  }
}
