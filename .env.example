## Runtime PostgreSQL/Neon (pooled) e migrations/admin (direct).
DATABASE_URL="postgresql://app_runtime:replace-me@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_ADMIN_URL="postgresql://neondb_owner:replace-me@ep-example.region.aws.neon.tech/neondb?sslmode=require"
# Padrão e produção: neon-serverless. Use node-postgres apenas para PostgreSQL
# TCP local/efêmero em integração e E2E.
DATABASE_DRIVER="neon-serverless"

## Exclusivo do processo único de migração; deve ser uma conexão direta com
## permissão de leitura em auth/public. O script força transação read-only.
SUPABASE_MIGRATION_DATABASE_URL=""
MIGRATION_APPLY="false"
MIGRATION_ALLOW_UPSERT="false"
MIGRATION_REPORT_PATH=""

## Better Auth server-side. Gere um segredo aleatório com pelo menos 32 bytes.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_TRUSTED_ORIGINS="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

## E-mail transacional (Resend).
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Preço que Dá Lucro <auth@example.com>"

## Gateway e orçamento de IA. O endpoint pode apontar para qualquer adapter
## compatível com o contrato Chat Completions usado pelo BFF.
AI_GATEWAY_URL="https://ai.gateway.lovable.dev/v1/chat/completions"
AI_GATEWAY_API_KEY=""
AI_MODEL="google/gemini-3.6-flash"
AI_REQUEST_TIMEOUT_MS="60000"
AI_MODEL_TIMEOUT_MS="30000"
AI_MODEL_MAX_ATTEMPTS="2"
AI_MAX_TOOL_ROUNDS="8"
AI_CHAT_LIMIT_PER_10_MINUTES="20"
AI_DAILY_CHAT_LIMIT_PER_TENANT="200"

## Observabilidade opcional. Não configure o endpoint para manter exportação
## desligada. CSP permanece Report-Only até o gate de staging ser aprovado.
OTEL_SERVICE_NAME="preco-que-da-lucro"
OTEL_EXPORTER_OTLP_ENDPOINT=""
CSP_ENFORCE="false"
